# Copy to .env and adjust. All values have safe offline defaults.

# --- LLM (DeepSeek V4 Flash by default; any OpenAI-compatible endpoint works) ---
XDD_LLM_PROVIDER=deepseek
XDD_LLM_BASE_URL=https://api.deepseek.com/v1
XDD_LLM_MODEL=deepseek-v4-flash
XDD_LLM_API_KEY=            # leave empty to use the offline stub LLM
XDD_LLM_USE_STUB=false      # force the deterministic offline stub
XDD_LLM_TEMPERATURE=0.4
XDD_LLM_MAX_TOKENS=2048

# --- Risk / survival guardrails ---
XDD_RISK_SEED_CAPITAL=150000        # ~10-20만원
XDD_RISK_CURRENCY=KRW
XDD_RISK_MAX_POSITION_PCT=0.25
XDD_RISK_MIN_CASH_PCT=0.20
XDD_RISK_DAILY_LOSS_LIMIT_PCT=0.05
XDD_RISK_MAX_DRAWDOWN_PCT=0.15
XDD_RISK_KELLY_FRACTION=0.25
XDD_RISK_MIN_CONFIDENCE_TO_TRADE=0.55

# --- Data sources ---
# JSON-encoded lists for the RSS/subreddit settings:
# XDD_DATA_NEWS_RSS_URLS=["https://feeds.a.dj.com/rss/RSSMarketsMain.xml"]
# XDD_DATA_REDDIT_SUBREDDITS=["stocks","wallstreetbets"]
# XDD_DATA_WATCHLIST=["AAPL","TSLA","NVDA","BTC","ETH"]
XDD_DATA_X_BEARER_TOKEN=            # X collector is a stub until this is set

# --- Broker ---
XDD_BROKER_BACKEND=paper            # paper | alpaca
XDD_BROKER_ALPACA_KEY_ID=
XDD_BROKER_ALPACA_SECRET_KEY=
XDD_BROKER_ALPACA_BASE_URL=https://paper-api.alpaca.markets
XDD_BROKER_LIVE_TRADING=false       # real money — keep false until validated
XDD_BROKER_REQUIRE_HUMAN_APPROVAL=true

# --- App ---
XDD_DB_PATH=xdd.db
XDD_POLL_INTERVAL_MINUTES=60
XDD_MAX_EVENTS_PER_CYCLE=8
XDD_LOG_LEVEL=INFO
